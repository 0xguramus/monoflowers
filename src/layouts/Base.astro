---
import { SITE, CATEGORIES } from '../lib/site';
const { title, description = SITE.tagline } = Astro.props;
---
<!doctype html>
<html lang="ka"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title ? `${title} — ${SITE.name}` : SITE.name}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#2a0a0c" />
<script is:inline>(function(){var t=localStorage.getItem("theme");if(!t)t="dark";document.documentElement.dataset.theme=t;document.querySelector('meta[name=theme-color]').content=t==="dark"?"#2a0a0c":"#f6ecd6"})()</script>
<link rel="icon" href="/logo-square.jpg" /><link rel="apple-touch-icon" href="/logo-square.jpg" /><meta property="og:image" content="/logo-square.jpg" />
<link rel="preload" href="/fonts/bpg-mrgvlovani-webfont.woff2" as="font" type="font/woff2" crossorigin />
</head><body>
<header class="top"><a href="/" class="logo" aria-label="monoflowers"><span class="lg"><img class="ld" src="/logo.png" alt="monoflowers" /><img class="ll" src="/logo-light.png" alt="" aria-hidden="true" /></span></a>
<nav><a href="/catalog/">კატალოგი</a><a href="/about/"><span class="hm">ჩვენ </span>შესახებ</a><button id="theme" class="tbtn" aria-label="მუქი/ღია რეჟიმი" title="მუქი/ღია რეჟიმი">◐</button></nav></header>
<main><slot /></main>
<a href="/cart/" id="fcart" class="fcart" aria-label="კალათა" hidden><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l1 13H5L6 7z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg><span>კალათა</span><span id="cartn">0</span></a>
<footer><p class="logo"><span class="lg"><img class="ld" src="/logo.png" alt="monoflowers" /><img class="ll" src="/logo-light.png" alt="" aria-hidden="true" /></span></p><p>{SITE.address} · {SITE.hours}</p>
<p><a href={`tel:${SITE.phone}`}>{SITE.phone}</a> · <a href={`https://instagram.com/${SITE.instagram}`}>Instagram</a> · <a href="/about/">ჩვენ შესახებ</a></p>
<p class="muted">© {new Date().getFullYear()} {SITE.name}</p></footer>
<script is:inline>document.getElementById("theme").onclick=function(){var d=document.documentElement,t=d.dataset.theme==="dark"?"light":"dark";d.dataset.theme=t;localStorage.setItem("theme",t);document.querySelector('meta[name=theme-color]').content=t==="dark"?"#2a0a0c":"#f6ecd6"}</script>
<div id="toast" role="status" aria-live="polite"></div>
<script is:inline>(function(){var K="mfcart";function g(){try{return JSON.parse(localStorage.getItem(K))||[]}catch(e){return[]}}
function s(c){localStorage.setItem(K,JSON.stringify(c));b()}
function b(){var n=g().reduce(function(a,i){return a+i.q},0),e=document.getElementById("cartn");e.textContent=n;document.getElementById("fcart").hidden=!n||location.pathname.indexOf("/cart")===0}
var tt;function toast(m){var t=document.getElementById("toast");t.textContent=m;t.classList.add("on");clearTimeout(tt);tt=setTimeout(function(){t.classList.remove("on")},1800)}
window.mfCart={get:g,set:s,toast:toast,add:function(it){var c=g(),f=c.find(function(i){return i.id===it.id});if(f)f.q++;else{it.q=1;c.push(it)}s(c);toast("დაემატა კალათაში")}};
document.addEventListener("click",function(e){var a=e.target.closest("[data-add]");if(!a)return;e.preventDefault();if(a.disabled)return;mfCart.add({id:a.dataset.add,name:a.dataset.name,price:+a.dataset.price,img:a.dataset.img})});
b();addEventListener("storage",b);addEventListener("pageshow",b)})()</script>
</body></html>
<style is:global>
@font-face{font-family:"BPG Mrgvlovani";src:url(/fonts/bpg-mrgvlovani-webfont.woff2) format("woff2"),url(/fonts/bpg-mrgvlovani-webfont.woff) format("woff");font-display:swap}
:root{--bg:#f6ecd6;--card:#fffaf0;--ink:#3b0d0d;--muted:#86605a;--rose:#760000;--sage:#a8846b;--r:6px;--line:#dfc3b0;--glass:rgba(246,236,214,.92);--chip-on-ink:#f6ecd6;--chip:#fffaf0;--chip-on:#760000;--badge:#f0d9cc;--shadow:rgba(118,0,0,.08);--pill:rgba(255,250,240,.94);--btn:#760000;--btn-ink:#f6ecd6;--photo:#fff}
[data-theme=dark]{--bg:#2a0a0c;--card:#3a1214;--ink:#f6ecd6;--muted:#cdb3a6;--rose:#f6ecd6;--sage:#c9a98e;--line:#6e2226;--glass:rgba(42,10,12,.92);--chip-on-ink:#2a0a0c;--chip:#3a1214;--chip-on:#f6ecd6;--badge:#4f1a1d;--shadow:rgba(0,0,0,.35);--pill:rgba(42,10,12,.88);--btn:#f6ecd6;--btn-ink:#3a0a0c;--photo:#f4f1ee;color-scheme:dark}
.lg img{height:22px;width:auto;display:block}.top nav{display:flex;align-items:center;white-space:nowrap}@media(max-width:480px){.top .lg img{height:15px}.hm{display:none}.top{padding-left:12px!important;padding-right:12px!important}.top nav a{margin-left:9px;font-size:13px}.tbtn{margin-left:10px!important;width:30px!important;height:30px!important}}.lg .ll{display:none}[data-theme=dark] .lg .ld{display:none}[data-theme=dark] .lg .ll{display:block}footer .lg{display:inline-block}footer .lg img{height:18px}
.btn.ph{background:var(--btn)!important;color:var(--btn-ink)!important}html,body{overflow-x:hidden}
.tbtn{margin-left:14px;background:none;border:1px solid var(--line);color:var(--ink);border-radius:6px;width:34px;height:34px;font-size:17px;cursor:pointer;vertical-align:middle}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 "BPG Mrgvlovani",system-ui,sans-serif;-webkit-font-smoothing:antialiased}
h1,h2,h3,.logo{font-family:"BPG Mrgvlovani",sans-serif;font-weight:400;line-height:1.25}
a{color:inherit}main{max-width:1100px;margin:0 auto;padding:0 18px 40px}
.top{position:sticky;top:0;z-index:5;display:flex;justify-content:space-between;align-items:center;padding:14px 18px;padding-top:max(14px,env(safe-area-inset-top));background:var(--glass);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.top nav a{margin-left:16px;text-decoration:none;font-size:15px}.logo{text-decoration:none;font-size:20px;margin:0}.logo span{color:var(--rose)}
footer{text-align:center;padding:32px 18px calc(32px + env(safe-area-inset-bottom));border-top:1px solid var(--line);font-size:14px}.muted{color:var(--muted)}
.grid{display:grid;grid-template-columns:minmax(0,1fr);gap:14px}@media(min-width:560px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(min-width:760px){.grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}}@media(min-width:1000px){.grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
.btn{display:block;text-align:center;padding:14px;border-radius:6px;text-decoration:none;font-weight:500;margin:8px 0}
.btn.wa{background:#25d366;color:#fff}.btn.ph{background:var(--rose);color:#fff}.btn.ig{border:1.5px solid var(--ink)}
.chips{display:flex;gap:8px;overflow-x:auto;padding:4px 0 16px;scrollbar-width:none}.chips::-webkit-scrollbar{display:none}.chips a{white-space:nowrap;padding:8px 16px;border-radius:6px;background:var(--chip);text-decoration:none;font-size:14px;border:1px solid var(--line)}.chips a.on{background:var(--chip-on);border-color:var(--chip-on);color:var(--chip-on-ink)}
.badge{display:inline-block;font-size:12px;padding:2px 10px;border-radius:6px;background:var(--badge);color:var(--rose)}
.cartlink{position:relative;margin-left:14px;display:inline-grid;place-items:center;width:34px;height:34px;text-decoration:none}
.fcart{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(16px + env(safe-area-inset-bottom));z-index:20;display:flex;align-items:center;gap:10px;padding:13px 22px;border-radius:6px;background:var(--btn);color:var(--btn-ink);text-decoration:none;font-size:15px;box-shadow:0 6px 20px rgba(0,0,0,.35);white-space:nowrap}.fcart[hidden]{display:none}#cartn{min-width:22px;height:22px;padding:0 6px;border-radius:4px;background:var(--btn-ink);color:var(--btn);font-size:13px;line-height:22px;text-align:center}
@media(max-width:480px){.top nav .cartlink{margin-left:8px;width:30px;height:30px}}
#toast{position:fixed;left:50%;bottom:calc(84px + env(safe-area-inset-bottom));transform:translate(-50%,20px);opacity:0;pointer-events:none;background:var(--btn);color:var(--btn-ink);padding:10px 18px;border-radius:6px;font-size:14px;transition:.25s;z-index:20;white-space:nowrap;box-shadow:0 4px 16px rgba(0,0,0,.35)}#toast.on{opacity:1;transform:translate(-50%,0)}
@media(max-width:400px){.top .lg img{height:13px}.top nav a{margin-left:7px;font-size:12.5px}.top nav .cartlink{margin-left:6px}.tbtn{margin-left:6px!important;width:28px!important;height:28px!important;font-size:15px}}
body{padding-bottom:70px}
</style>
