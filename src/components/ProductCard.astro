---
import { gel, CATEGORIES } from '../lib/site';
const { p } = Astro.props; const d = p.data;
const short = d.description.replace(/\s*\(ნიმუში[^)]*\)\s*/g, ' ').trim();
const url = `/products/${p.id}/`;
---
<article class="card" data-q={`${d.name} ${short} ${CATEGORIES[d.category] ?? ""}`.toLowerCase()} data-price={d.price} data-o={d.order ?? 0}>
  <div class="img">
    <a href={url} tabindex="-1"><img src={d.images[0] ?? '/images/placeholder.svg'} alt={d.name} loading="lazy" /></a>
    <div class="badges">{!d.available && <span class="bd out">ამოიწურა</span>}{d.old_price && <span class="bd">ფასდაკლება</span>}{d.featured && <span class="bd">ჰიტი</span>}</div>
    {d.example && <span class="ex">ნიმუში</span>}
    <button type="button" class="order" data-add={p.id} data-name={d.name} data-price={d.price} data-img={d.images[0] ?? ''} disabled={!d.available} aria-label="შეკვეთა" title="კალათაში დამატება">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l1 13H5L6 7z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg>
    </button>
  </div>
  <div class="body">
    <h3><a href={url}>{d.name}</a></h3>
    <p class="desc">{short}</p>
    <p class="price">{d.old_price && <s>{gel(d.old_price)}</s>} <b>{gel(d.price)}</b></p>
  </div>
</article>
<style>
.card{background:var(--card);border:1px solid var(--line);border-radius:6px;overflow:hidden;display:flex;flex-direction:column;min-width:0}
.img{position:relative;aspect-ratio:4/5;background:var(--photo)}.img a:first-child,.img img{display:block;width:100%;height:100%}.img img{object-fit:cover}
.badges{position:absolute;left:8px;top:8px;display:flex;flex-direction:column;align-items:flex-start;gap:4px}
.bd{background:#760000;color:#f6ecd6;font-size:11px;line-height:1;padding:6px 8px;border-radius:3px}.bd.out{background:#3a3030}
.ex{position:absolute;right:8px;top:8px;font-size:10px;background:var(--pill);color:var(--ink);padding:2px 7px;border-radius:6px}
.order{position:absolute;right:10px;bottom:10px;width:44px;height:44px;border-radius:50%;background:#760000;color:#f6ecd6;display:grid;place-items:center;box-shadow:0 3px 10px rgba(0,0,0,.3);border:0;cursor:pointer;padding:0}.order:disabled{opacity:.45;cursor:not-allowed}
[data-theme=dark] .order{border:1px solid rgba(246,236,214,.35)}
.body{padding:10px 12px 12px;display:flex;flex-direction:column;flex:1;min-width:0}
h3{font-size:15px;font-weight:700;margin:0 0 4px;line-height:1.3;color:var(--rose);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}h3 a{text-decoration:none}
.desc{margin:0 0 10px;color:var(--muted);font-size:12.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.price{margin:auto 0 0;display:flex;align-items:baseline;gap:6px;flex-wrap:wrap}s{color:var(--muted);font-size:12px}b{font-size:15px;font-weight:700}
</style>
