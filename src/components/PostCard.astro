---
import { fmtDate } from '../lib/site';
const { p } = Astro.props; const d = p.data;
---
<a class="post" href={`/blog/${p.id}/`}>
  <div class="cv">{d.cover ? <img src={d.cover} alt="" loading="lazy" /> : <span class="ph"></span>}{d.example && <span class="ex">ნიმუში</span>}</div>
  <div class="tx"><time datetime={d.date.toISOString().slice(0, 10)}>{fmtDate(d.date)}</time><h3>{d.title}</h3><p>{d.excerpt}</p></div>
</a>
<style>
.post{display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;text-decoration:none;min-width:0}
.cv{position:relative;aspect-ratio:16/10;background:var(--photo);overflow:hidden}.cv img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}.ph{display:block;height:100%;background:linear-gradient(135deg,#760000,#2a0a0c)}
.ex{position:absolute;right:8px;top:8px;font-size:10px;background:var(--pill);color:var(--ink);padding:2px 7px;border-radius:999px}
.tx{padding:12px 14px 16px}time{font-size:12px;color:var(--muted)}h3{margin:4px 0 6px;font-size:17px;font-weight:700;color:var(--rose)}
p{margin:0;font-size:14px;color:var(--muted);line-height:1.5;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
</style>
