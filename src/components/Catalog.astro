---
import ProductCard from './ProductCard.astro';
import { CATEGORIES } from '../lib/site';
const { items, current } = Astro.props;
---
<h1>{current ? CATEGORIES[current] : 'კატალოგი'}</h1>
<div class="chips"><a href="/catalog/" class={!current ? 'on' : ''}>ყველა</a>
{Object.entries(CATEGORIES).map(([k, v]) => <a href={`/catalog/${k}/`} class={current === k ? 'on' : ''}>{v}</a>)}</div>
{items.length ? <>
<label class="search"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input id="q" type="search" placeholder="ძებნა თაიგულებში…" aria-label="ძებნა" /></label>
<div class="bar"><p class="count muted"><span id="cnt">{items.length}</span> პროდუქტი</p><div class="view" role="group" aria-label="ხედი"><button type="button" data-cols="1" aria-label="ერთი სვეტი" title="ერთი სვეტი"><svg viewBox="0 0 18 18" width="16" height="16" aria-hidden="true"><rect x="2" y="2" width="14" height="14" rx="1.5" fill="currentColor"/></svg></button><button type="button" data-cols="2" aria-label="ორი სვეტი" title="ორი სვეტი"><svg viewBox="0 0 18 18" width="16" height="16" aria-hidden="true"><rect x="2" y="2" width="6" height="6" rx="1" fill="currentColor"/><rect x="10" y="2" width="6" height="6" rx="1" fill="currentColor"/><rect x="2" y="10" width="6" height="6" rx="1" fill="currentColor"/><rect x="10" y="10" width="6" height="6" rx="1" fill="currentColor"/></svg></button></div></div>
<div class="grid" id="list">{items.map(p => <ProductCard p={p} />)}</div>
<script is:inline>(function(){var l=document.getElementById("list"),bs=document.querySelectorAll(".view button");function set(c){l.classList.toggle("one",c==="1");bs.forEach(function(b){b.classList.toggle("on",b.dataset.cols===c);b.setAttribute("aria-pressed",b.dataset.cols===c)})}set(localStorage.getItem("mfcols")||"2");bs.forEach(function(b){b.onclick=function(){localStorage.setItem("mfcols",b.dataset.cols);set(b.dataset.cols)}})})()</script>
<p id="none" class="muted" hidden>ვერაფერი მოიძებნა.</p>
<script is:inline>(function(){var q=document.getElementById("q"),c=[].slice.call(document.querySelectorAll("#list .card"));q.addEventListener("input",function(){var v=q.value.trim().toLowerCase(),n=0;c.forEach(function(e){var m=!v||e.dataset.q.indexOf(v)>-1;e.hidden=!m;if(m)n++});document.getElementById("cnt").textContent=n;document.getElementById("none").hidden=n>0})})()</script>
</> : <p class="muted">ამ კატეგორიაში პროდუქცია ჯერ არ არის.</p>}
<style>
.search{display:flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--line);border-radius:6px;padding:0 16px;color:var(--muted)}
.search input{flex:1;min-width:0;background:none;border:0;outline:0;color:var(--ink);font:inherit;font-size:16px;padding:11px 0}
.search input::placeholder{color:var(--muted)}
.bar{display:flex;justify-content:space-between;align-items:center;margin:10px 0 12px}.count{font-size:13px;margin:0}.view{display:flex;gap:6px}.view button{width:34px;height:34px;display:grid;place-items:center;border:1px solid var(--line);background:var(--card);color:var(--muted);border-radius:6px;cursor:pointer;padding:0}.view button.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}@media(min-width:560px){.view{display:none}}:global(.grid.one){grid-template-columns:minmax(0,1fr)!important}@media(min-width:560px){:global(.grid.one){grid-template-columns:repeat(3,minmax(0,1fr))!important}}@media(min-width:1000px){:global(.grid.one){grid-template-columns:repeat(4,minmax(0,1fr))!important}}
:global(.card[hidden]){display:none!important}
</style>
