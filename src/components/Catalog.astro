---
import ProductCard from './ProductCard.astro';
import { CATEGORIES } from '../lib/site';
const { items, current } = Astro.props;
---
<h1>{current ? CATEGORIES[current] : 'კატალოგი'}</h1>
<div class="chips"><a href="/catalog/" class={!current ? 'on' : ''}>ყველა</a>
{Object.entries(CATEGORIES).map(([k, v]) => <a href={`/catalog/${k}/`} class={current === k ? 'on' : ''}>{v}</a>)}</div>
{items.length ? <>
<label class="search"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input id="q" type="search" placeholder="ძებნა თაიგულებში…" aria-label="ძებნა" /></label>
<p class="count muted"><span id="cnt">{items.length}</span> პროდუქტი</p>
<div class="grid" id="list">{items.map(p => <ProductCard p={p} />)}</div>
<p id="none" class="muted" hidden>ვერაფერი მოიძებნა.</p>
<script is:inline>(function(){var q=document.getElementById("q"),c=[].slice.call(document.querySelectorAll("#list .card"));q.addEventListener("input",function(){var v=q.value.trim().toLowerCase(),n=0;c.forEach(function(e){var m=!v||e.dataset.q.indexOf(v)>-1;e.hidden=!m;if(m)n++});document.getElementById("cnt").textContent=n;document.getElementById("none").hidden=n>0})})()</script>
</> : <p class="muted">ამ კატეგორიაში პროდუქცია ჯერ არ არის.</p>}
<style>
.search{display:flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--line);border-radius:999px;padding:0 16px;color:var(--muted)}
.search input{flex:1;min-width:0;background:none;border:0;outline:0;color:var(--ink);font:inherit;font-size:16px;padding:11px 0}
.search input::placeholder{color:var(--muted)}
.count{font-size:13px;margin:10px 0 12px}
:global(.card[hidden]){display:none!important}
</style>
