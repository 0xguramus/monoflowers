---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { render } from 'astro:content';
import { getPosts } from '../../lib/blog';
import { fmtDate } from '../../lib/site';
export async function getStaticPaths() { const all = await getPosts(); return all.map(p => ({ params: { slug: p.id }, props: { p, more: all.filter(x => x.id !== p.id).slice(0, 2) } })); }
const { p, more } = Astro.props; const d = p.data;
const { Content } = await render(p);
---
<Base title={d.title} description={d.excerpt}>
<article>
<a class="back" href="/blog/">‹ ბლოგი</a>
<time datetime={d.date.toISOString().slice(0, 10)}>{fmtDate(d.date)}</time>
<h1>{d.title}</h1>
{d.cover && <img class="cover" src={d.cover} alt="" />}
<div class="prose"><Content /></div>
</article>
{more.length > 0 && <section class="more"><h2>სხვა სტატიები</h2><div class="pg">{more.map(x => <PostCard p={x} />)}</div></section>}
</Base>
<style>
article{max-width:680px;margin:0 auto}.back{display:inline-block;margin:16px 0 10px;text-decoration:none;font-weight:700}
time{display:block;font-size:13px;color:var(--muted)}h1{font-size:28px;margin:4px 0 16px;line-height:1.3}
.cover{width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:var(--r);display:block;margin-bottom:20px;background:var(--photo)}
.prose{font-size:17px;line-height:1.8}.prose :global(h2){font-size:21px;margin:30px 0 8px;color:var(--rose);font-weight:700}
.prose :global(p){margin:0 0 16px}.prose :global(ul),.prose :global(ol){padding-left:22px;margin:0 0 16px}.prose :global(li){margin-bottom:6px}
.prose :global(a){color:var(--rose)}.prose :global(img){max-width:100%;border-radius:var(--r)}.prose :global(em){color:var(--muted)}
.prose :global(blockquote){margin:0 0 16px;padding:4px 16px;border-left:3px solid #760000;color:var(--muted)}
.more{max-width:680px;margin:40px auto 0}.more h2{font-size:20px}.pg{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}@media(max-width:480px){.pg{grid-template-columns:minmax(0,1fr)}}
</style>
