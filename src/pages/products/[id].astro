---
import Base from '../../layouts/Base.astro';
import Recent from '../../components/Recent.astro';
import { getCollection, render } from 'astro:content';
import { CATEGORIES, gel, waHref, phoneHref, igHref } from '../../lib/site';
export async function getStaticPaths() { return (await getCollection('products')).map(p => ({ params: { id: p.id }, props: { p } })); }
const { p } = Astro.props; const d = p.data;
const { Content } = await render(p);
const imgs = d.images.length ? d.images : ['/images/placeholder.svg'];
const url = new URL(`/products/${p.id}/`, Astro.site).href;
---
<Base title={d.name} description={d.description}>
<div class="wrap">
<div class="gal">
<div class="gallery" id="gal">{imgs.map((src, i) => <img src={src} alt={imgs.length > 1 ? `${d.name} — ფოტო ${i + 1}` : d.name} loading={i ? 'lazy' : 'eager'} decoding="async" />)}</div>
{imgs.length > 1 && <>
<button type="button" class="arr prev" aria-label="წინა ფოტო">‹</button><button type="button" class="arr next" aria-label="შემდეგი ფოტო">›</button>
<span class="cnt" aria-live="polite"><span id="gi">1</span> / {imgs.length}</span>
<div class="dots">{imgs.map((_, i) => <button type="button" data-i={i} class={i ? '' : 'on'} aria-label={`ფოტო ${i + 1}`}></button>)}</div>
<script is:inline>(function(){var g=document.getElementById("gal"),w=g.parentNode,d=w.querySelectorAll(".dots button"),n=d.length,c=0;
function go(i){i=(i+n)%n;g.scrollTo({left:i*g.clientWidth,behavior:"smooth"})}
g.addEventListener("scroll",function(){var i=Math.round(g.scrollLeft/g.clientWidth);if(i!==c){c=i;d.forEach(function(b,k){b.classList.toggle("on",k===i)});document.getElementById("gi").textContent=i+1}},{passive:true});
d.forEach(function(b){b.onclick=function(){go(+b.dataset.i)}});w.querySelector(".prev").onclick=function(){go(c-1)};w.querySelector(".next").onclick=function(){go(c+1)}})()</script>
</>}
</div>
<div class="info">
<a class="badge" href={`/catalog/${d.category}/`}>{CATEGORIES[d.category]}</a>
{d.example && <span class="badge">ნიმუში</span>}
<h1>{d.name}</h1>
<p class="price">{gel(d.price)} {d.old_price && <s>{gel(d.old_price)}</s>}</p>
<p>{d.description}</p>
{d.available ? <>
<button type="button" class="btn ph add" data-add={p.id} data-name={d.name} data-price={d.price} data-img={d.images[0] ?? ''}>კალათაში დამატება</button>
<a class="btn wa" href={waHref(`გამარჯობა! მინდა შევუკვეთო „${d.name}“ (${gel(d.price)}). ${url}`)}>კითხვა WhatsApp-ით</a>
<a class="btn ph" href={phoneHref()}>შეკვეთა ტელეფონით</a>
<a class="btn ig" href={igHref()}>მოგვწერე Instagram-ზე</a></> : <p class="muted">ეს პროდუქტი ამჟამად მიუწვდომელია. მსგავსი ვარიანტისთვის დაგვიკავშირდი.</p>}
<div class="body"><Content /></div>
</div></div>
<Recent current={p.id} />
<script is:inline define:vars={{ id: p.id }}>try{var r=JSON.parse(localStorage.getItem("mfrecent")||"[]").filter(function(x){return x!==id});r.unshift(id);localStorage.setItem("mfrecent",JSON.stringify(r.slice(0,12)))}catch(e){}</script>
</Base>
<style>
.wrap{display:grid;gap:20px;margin-top:16px}@media(min-width:760px){.wrap{grid-template-columns:1.1fr 1fr;gap:36px}}
.gal{position:relative;min-width:0}
.gallery{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;border-radius:var(--r);scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;background:var(--photo)}.gallery::-webkit-scrollbar{display:none}
.gallery img{flex:0 0 100%;width:100%;aspect-ratio:4/5;object-fit:cover;scroll-snap-align:start;scroll-snap-stop:always;display:block}
.arr{position:absolute;top:50%;transform:translateY(-50%);width:36px;height:36px;border-radius:50%;border:0;background:rgba(42,10,12,.45);color:#f6ecd6;font-size:24px;line-height:1;cursor:pointer;display:grid;place-items:center;padding:0 0 3px;opacity:.75;backdrop-filter:blur(4px)}
.arr:hover{opacity:1}.prev{left:8px}.next{right:8px}@media(min-width:760px){.arr{width:44px;height:44px;opacity:.9}}
.cnt{position:absolute;right:10px;top:10px;background:rgba(42,10,12,.55);color:#f6ecd6;font-size:12px;padding:2px 9px;border-radius:999px}
.dots{display:flex;justify-content:center;gap:8px;margin-top:10px}.dots button{width:8px;height:8px;padding:0;border-radius:50%;border:0;background:var(--line);cursor:pointer;transition:.2s}.dots button.on{background:var(--rose);width:20px;border-radius:4px}
h1{margin:10px 0 4px}.price{font-size:22px;color:var(--rose);margin:0 0 10px}s{color:var(--muted);font-size:16px}
.add{width:100%;border:0;font:inherit;cursor:pointer}
</style>
