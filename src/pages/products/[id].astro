---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { CATEGORIES, gel, waHref, phoneHref, igHref } from '../../lib/site';
export async function getStaticPaths() { return (await getCollection('products')).map(p => ({ params: { id: p.id }, props: { p } })); }
const { p } = Astro.props; const d = p.data;
const { Content } = await render(p);
const imgs = d.images.length ? d.images : ['/images/placeholder.svg'];
const url = new URL(`/products/${p.id}/`, Astro.site).href;
---
<Base title={d.name} description={d.description}>
<div class="wrap">
<div class="gallery">{imgs.map(src => <img src={src} alt={d.name} />)}</div>
<div class="info">
<a class="badge" href={`/catalog/${d.category}/`}>{CATEGORIES[d.category]}</a>
{d.example && <span class="badge">ნიმუში</span>}
<h1>{d.name}</h1>
<p class="price">{gel(d.price)} {d.old_price && <s>{gel(d.old_price)}</s>}</p>
<p>{d.description}</p>
{d.available ? <>
<button type="button" class="btn ph add" data-add={p.id} data-name={d.name} data-price={d.price} data-img={d.images[0] ?? ''}>კალათაში დამატება</button>
<a class="btn wa" href={waHref(`გამარჯობა! მინდა შევუკვეთო „${d.name}“ (${gel(d.price)}). ${url}`)}>კითხვა WhatsApp-ით</a>
<a class="btn ph" href={phoneHref()}>შეკვეთა ტელეფონით</a>
<a class="btn ig" href={igHref()}>მოგვწერე Instagram-ზე</a></> : <p class="muted">ეს პროდუქტი ამჟამად მიუწვდომელია. მსგავსი ვარიანტისთვის დაგვიკავშირდი.</p>}
<div class="body"><Content /></div>
</div></div>
</Base>
<style>
.wrap{display:grid;gap:20px;margin-top:16px}@media(min-width:760px){.wrap{grid-template-columns:1.1fr 1fr;gap:36px}}
.gallery{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:10px;border-radius:var(--r)}
.gallery img{flex:0 0 100%;width:100%;aspect-ratio:1/1;object-fit:cover;scroll-snap-align:start;border-radius:var(--r)}
h1{margin:10px 0 4px}.price{font-size:22px;color:var(--rose);margin:0 0 10px}s{color:var(--muted);font-size:16px}
.add{width:100%;border:0;font:inherit;cursor:pointer}
</style>
